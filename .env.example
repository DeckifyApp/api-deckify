NODE_ENV=development
PORT=3333

DATABASE_URL=postgresql://deckify:deckify@localhost:5432/deckify

# Docker Compose development defaults only; use secret-managed credentials outside local development.
POSTGRES_USER=deckify
POSTGRES_PASSWORD=deckify
POSTGRES_DB=deckify

JWT_ACCESS_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

CORS_ORIGIN=*
